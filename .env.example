# ===== 应用 =====
APP_PORT=8080
# production 时 Gin 以 release 模式运行
APP_ENV=production
TZ=Asia/Shanghai
# 必填：签发登录凭据的密钥，至少 32 个字符的随机字符串（如 openssl rand -hex 32）
JWT_SECRET=please-generate-a-long-random-string
# 登录凭据有效期（小时）
JWT_EXPIRE_HOURS=24
# 必填：首次启动时自动创建的管理员账号 admin 的初始密码
ADMIN_INITIAL_PASSWORD=please-change-me

# ===== 数据库 =====
DB_HOST=postgres
DB_PORT=5432
DB_USER=homeoa
# 必填
DB_PASSWORD=please-generate-a-strong-password
DB_NAME=homeoa

# ===== 邮件提醒（SMTP，如 QQ 邮箱使用授权码）=====
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=your-email@example.com
SMTP_PASSWORD=your-smtp-authorization-code
# 设为 true 前请先完整填写上面的 SMTP 配置
MAIL_ENABLED=false

# ===== 端口绑定 =====
# 默认只绑定本机回环地址；需要外网访问时改为 0.0.0.0 并确保有防火墙/反代防护
HOST_BIND=127.0.0.1
HOST_PORT=8080
